{
  "name": "edi-containers",
  "displayName": "ediContainers",
  "description": "Manage Apple container machines: create from templates, start/stop, delete, and connect via Remote SSH",
  "version": "0.2.1",
  "publisher": "tunerok",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1C1C1E",
    "theme": "dark"
  },
  "keywords": [
    "apple",
    "container",
    "containers",
    "vm",
    "machine",
    "ssh",
    "remote",
    "macos",
    "apple silicon",
    "docker"
  ],
  "homepage": "https://github.com/tunerok/apple-containers",
  "bugs": {
    "url": "https://github.com/tunerok/apple-containers/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tunerok/apple-containers.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "edi-containers",
          "title": "ediContainers",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "edi-containers": [
        {
          "id": "edi-containers.machines",
          "name": "Machines"
        }
      ]
    },
    "commands": [
      {
        "command": "edi-containers.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "edi-containers.createMachine",
        "title": "Create Machine",
        "icon": "$(add)"
      },
      {
        "command": "edi-containers.deleteMachine",
        "title": "Delete Machine",
        "icon": "$(trash)"
      },
      {
        "command": "edi-containers.editImageSettings",
        "title": "Edit Machine Image Settings",
        "icon": "$(gear)"
      },
      {
        "command": "edi-containers.editCustomDockerfile",
        "title": "Edit Custom Dockerfile",
        "icon": "$(file-code)"
      },
      {
        "command": "edi-containers.start",
        "title": "Start",
        "icon": "$(play)"
      },
      {
        "command": "edi-containers.stop",
        "title": "Stop",
        "icon": "$(debug-stop)"
      },
      {
        "command": "edi-containers.connectSsh",
        "title": "Connect via SSH",
        "icon": "$(remote)"
      },
      {
        "command": "edi-containers.copyIp",
        "title": "Copy IP"
      },
      {
        "command": "edi-containers.startSystem",
        "title": "Start Container System"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "edi-containers.createMachine",
          "when": "view == edi-containers.machines",
          "group": "navigation@1"
        },
        {
          "command": "edi-containers.editImageSettings",
          "when": "view == edi-containers.machines",
          "group": "navigation@2"
        },
        {
          "command": "edi-containers.editCustomDockerfile",
          "when": "view == edi-containers.machines",
          "group": "navigation@3"
        },
        {
          "command": "edi-containers.refresh",
          "when": "view == edi-containers.machines",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "edi-containers.start",
          "when": "view == edi-containers.machines && viewItem =~ /machineStopped/",
          "group": "inline@1"
        },
        {
          "command": "edi-containers.stop",
          "when": "view == edi-containers.machines && viewItem =~ /machineRunning/",
          "group": "inline@2"
        },
        {
          "command": "edi-containers.connectSsh",
          "when": "view == edi-containers.machines && viewItem =~ /machineRunning/",
          "group": "inline@3"
        },
        {
          "command": "edi-containers.start",
          "when": "view == edi-containers.machines && viewItem =~ /machineStopped/",
          "group": "1_actions@1"
        },
        {
          "command": "edi-containers.stop",
          "when": "view == edi-containers.machines && viewItem =~ /machineRunning/",
          "group": "1_actions@2"
        },
        {
          "command": "edi-containers.connectSsh",
          "when": "view == edi-containers.machines && viewItem =~ /machineRunning/",
          "group": "1_actions@3"
        },
        {
          "command": "edi-containers.copyIp",
          "when": "view == edi-containers.machines && viewItem =~ /machineHasIp/",
          "group": "1_actions@4"
        },
        {
          "command": "edi-containers.deleteMachine",
          "when": "view == edi-containers.machines && viewItem =~ /machine(Running|Stopped)/",
          "group": "9_danger@1"
        }
      ]
    },
    "configuration": {
      "title": "ediContainers",
      "properties": {
        "ediContainers.containerPath": {
          "type": "string",
          "default": "container",
          "description": "Path to the Apple container CLI binary"
        },
        "ediContainers.refreshInterval": {
          "type": "number",
          "default": 8000,
          "minimum": 3000,
          "description": "Auto-refresh interval in milliseconds (0 to disable)"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "compile:cursor": "PATH=\"/Applications/Cursor.app/Contents/Resources/app/resources/helpers:$PATH\" node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
