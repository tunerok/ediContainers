{
  "name": "apple-containers",
  "displayName": "Apple Containers",
  "description": "Manage Apple container machines: list, start/stop, and connect via Remote SSH",
  "version": "0.1.0",
  "publisher": "artem",
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apple-containers",
          "title": "Apple Containers",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "apple-containers": [
        {
          "id": "apple-containers.machines",
          "name": "Machines"
        }
      ]
    },
    "commands": [
      {
        "command": "apple-containers.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "apple-containers.start",
        "title": "Start",
        "icon": "$(play)"
      },
      {
        "command": "apple-containers.stop",
        "title": "Stop",
        "icon": "$(debug-stop)"
      },
      {
        "command": "apple-containers.connectSsh",
        "title": "Connect via SSH",
        "icon": "$(remote)"
      },
      {
        "command": "apple-containers.startSystem",
        "title": "Start Container System"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "apple-containers.refresh",
          "when": "view == apple-containers.machines",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "apple-containers.start",
          "when": "view == apple-containers.machines && viewItem == machineStopped",
          "group": "inline@1"
        },
        {
          "command": "apple-containers.stop",
          "when": "view == apple-containers.machines && viewItem == machineRunning",
          "group": "inline@2"
        },
        {
          "command": "apple-containers.connectSsh",
          "when": "view == apple-containers.machines && viewItem == machineRunning",
          "group": "inline@3"
        },
        {
          "command": "apple-containers.start",
          "when": "view == apple-containers.machines && viewItem == machineStopped",
          "group": "1_actions@1"
        },
        {
          "command": "apple-containers.stop",
          "when": "view == apple-containers.machines && viewItem == machineRunning",
          "group": "1_actions@2"
        },
        {
          "command": "apple-containers.connectSsh",
          "when": "view == apple-containers.machines && viewItem == machineRunning",
          "group": "1_actions@3"
        }
      ]
    },
    "configuration": {
      "title": "Apple Containers",
      "properties": {
        "appleContainers.containerPath": {
          "type": "string",
          "default": "container",
          "description": "Path to the Apple container CLI binary"
        },
        "appleContainers.refreshInterval": {
          "type": "number",
          "default": 8000,
          "minimum": 3000,
          "description": "Auto-refresh interval in milliseconds (0 to disable)"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "compile:cursor": "PATH=\"/Applications/Cursor.app/Contents/Resources/app/resources/helpers:$PATH\" node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
